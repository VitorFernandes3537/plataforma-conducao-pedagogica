# Copie para .env.local e preencha. .env.local não vai para o repositório.

# Postgres gerenciado (Neon). Sem default: um fallback silencioso aplicaria
# migration no banco errado, e a partir do D1 esse banco carrega nota real.
DATABASE_URL=

# Auth.js — gere com: npx auth secret
AUTH_SECRET=

# OAuth do GitHub, usado só como identidade no login.
# Registre em https://github.com/settings/developers
# Callback local: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
